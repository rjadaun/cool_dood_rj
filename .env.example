# ─────────────────────────────────────────────────────────────
#  Lumière Studio — Environment Variables
#  Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# Database (MongoDB). Local dev via `npm run db:server` (single-node replica set):
DATABASE_URL="mongodb://127.0.0.1:27017/lumiere?replicaSet=rs0"
# Production (MongoDB Atlas) looks like:
# DATABASE_URL="mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/lumiere?retryWrites=true&w=majority"

# Public base URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth.js (NextAuth v5) ──
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Trust the deployment host (needed on some platforms)
AUTH_TRUST_HOST="true"

# Credentials for the first super-admin created by the seed script
ADMIN_EMAIL="admin@lumiere.studio"
ADMIN_PASSWORD="ChangeMe!2026"
ADMIN_NAME="Studio Admin"

# ── File storage ──
# STORAGE_PROVIDER: "local" (default, ./storage) | "cloudinary" | "s3"
STORAGE_PROVIDER="local"

# S3-compatible (AWS S3 / Cloudflare R2 / MinIO / B2) — only if STORAGE_PROVIDER=s3
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""

# Cloudinary — only if STORAGE_PROVIDER=cloudinary
# Find these on your Cloudinary dashboard (Account Details / API Keys).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="lumiere"

# ── Email ──
# EMAIL_PROVIDER: "log" (default, prints to console) or "resend"
EMAIL_PROVIDER="log"
EMAIL_FROM="Lumière Studio <hello@lumiere.studio>"
RESEND_API_KEY=""

# ── Analytics (optional, managed from admin settings too) ──
NEXT_PUBLIC_GA_ID=""

# Rate-limit window bypass for local dev (optional)
RATE_LIMIT_DISABLED="false"
